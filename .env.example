# Copy to .env and edit. Never commit .env. Every setting has the NCM_ prefix
# (see src/ncm_lab/api/settings.py).
NCM_ARTIFACTS_DIR=artifacts
NCM_DATA_DIR=data
NCM_DEVICE=cuda
NCM_PRECISION=fp16
# real = load GPU models at startup, fake = tiny stand-ins (no GPU)
NCM_BACKEND=real
NCM_REQUEST_TIMEOUT_S=60
NCM_RAG_TOP_K=3
NCM_OLLAMA_HOST=http://localhost:11434
NCM_OLLAMA_MODEL=qwen2.5:3b
NCM_LOG_LEVEL=INFO
